# Backend API URL. Local development normally overrides this in .env.local.
NEXT_PUBLIC_API_BASE=http://example.com/api/v1
NEXT_PUBLIC_SITE_URL=https://example.com

# Value from Google Search Console > Settings > Ownership verification.
GOOGLE_SITE_VERIFICATION=abcdef

# Must be identical to FRONTEND_REVALIDATION_SECRET in the backend Vercel project.
FRONTEND_REVALIDATION_SECRET=abcdef

# App Environment
NEXT_PUBLIC_ENV=example
