{
  "name": "vomamxenang-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start:dev": "prisma generate && nest start --watch",
    "dev": "prisma generate && nest start --watch",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start:prod": "node dist/main.js",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:local": "DOTENV_CONFIG_PATH=.env.local node -r dotenv/config ./node_modules/prisma/build/index.js migrate deploy",
    "prisma:push:local": "DOTENV_CONFIG_PATH=.env.local node -r dotenv/config ./node_modules/prisma/build/index.js db push",
    "seed": "prisma generate && ts-node --transpile-only prisma/seed.ts",
    "db:seed": "yarn seed",
    "db:content:sync:local": "prisma generate && ts-node --transpile-only prisma/seed-content.ts",
    "db:sync:local": "yarn prisma:migrate:local && yarn db:seed && yarn db:content:sync:local",
    "db:seed:production": "prisma generate && ts-node --transpile-only prisma/seed-production.ts",
    "db:sync:production": "yarn prisma:migrate && APP_ENV=production yarn db:seed:production",
    "test:production-seed": "ts-node --transpile-only test/production-seed-runner.spec.ts",
    "seo": "ts-node --transpile-only scripts/seo.ts",
    "test:seo": "ts-node --transpile-only test/seo.spec.ts && ts-node --transpile-only test/seo-v31.spec.ts",
    "test:content": "ts-node --transpile-only test/content-alias.spec.ts",
    "test:warehouse": "ts-node --transpile-only test/day2-warehouse-cleanup-draft.spec.ts",
    "test:ci": "yarn test:seo && yarn test:production-seed && yarn test:content && yarn test:product-seo-migration && yarn test:warehouse && yarn test:critical && yarn test:integration:critical",
    "test:critical": "ts-node --transpile-only test/auth-critical.spec.ts && ts-node --transpile-only test/inventory-critical.spec.ts && ts-node --transpile-only test/orders-critical.spec.ts && ts-node --transpile-only test/webhook-critical.spec.ts",
    "test:integration:critical": "ts-node --transpile-only test/postgres-critical.integration.spec.ts",
    "prisma:migrate:drift-check": "prisma migrate diff --from-url \"$DATABASE_URL\" --to-schema-datamodel prisma/schema.prisma --exit-code",
    "product:seo:migrate:dry": "ts-node --transpile-only scripts/product-seo-content-migration.ts",
    "product:seo:migrate": "ts-node --transpile-only scripts/product-seo-content-migration.ts --apply",
    "test:product-seo-migration": "ts-node --transpile-only test/product-seo-migration.spec.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.0.0",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@prisma/client": "^5.12.0",
    "bcryptjs": "^2.4.3",
    "cheerio": "1.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "ipaddr.js": "2.2.0",
    "nestjs-pino": "^4.6.1",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.1.13",
    "robots-parser": "3.0.1",
    "rxjs": "^7.0.0",
    "stripe": "^22.1.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/bcryptjs": "^2.4.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.2",
    "@types/passport-jwt": "^3.0.9",
    "pino-pretty": "^13.1.3",
    "prisma": "^5.12.0",
    "ts-node": "^10.0.0",
    "typescript": "^5.5.0"
  }
}
