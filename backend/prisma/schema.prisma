datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN_MANAGER
  STOREKEEPER
}

enum ProductType {
  TIRE
  RIM
  SERVICE
}

enum TireType {
  SOLID
  PNEUMATIC
  NON_MARKING
}

enum RimType {
  LIP
  CLICK
  STANDARD
}

enum TireCondition {
  NEW
  USED
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
}

enum AiGenerationType {
  PRODUCT
  BLOG
  SEO
}

enum AiGenerationStatus {
  PENDING
  SUCCESS
  FAILED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum TransactionType {
  IMPORT        // Nhập kho thông thường
  EXPORT        // Xuất kho bán hàng
  ASSEMBLY_OUT  // Xuất vỏ/mâm để mang đi ép thành bộ
  ASSEMBLY_IN   // Nhập bộ vỏ mâm hoàn chỉnh sau khi ép (hoặc rã bánh)
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      Role     @default(STOREKEEPER)
  createdAt DateTime @default(now())
  productComments ProductComment[]
  favouriteProducts FavouriteProduct[]
  postComments PostComment[]
}

model Client {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  phone     String
  company   String?
  type      String   @default("RETAIL") // RETAIL (Khách lẻ), B2B_TIER1, B2B_TIER2
  notes     String?
  createdAt DateTime @default(now())
  orders    Order[]
}

model Supplier {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  phone     String?
  company   String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
}

model Category {
  id            String    @id @default(uuid())
  name          String
  tireSize      String
  brand         String
  tireType      TireType
  rimType       RimType
  origin        String
  condition     TireCondition
  specifications String?
  createdAt     DateTime  @default(now())
  stocks        Stock[]
}

model Product {
  id              String        @id @default(uuid())
  sku             String        @unique // Mã QR tổng sản phẩm
  type            ProductType   @default(TIRE)
  name            String        // Tên mô tả (Ví dụ: Vỏ đặc Casumina 6.00-9)
  
  // Thuộc tính đặc thù lốp xe nâng
  size            String?       // Thông số kích thước: 6.00-9, 7.00-12
  brand           String?       // Bridgestone, Casumina, Michelin...
  tireType        String?       // Solid (Đặc), Pneumatic (Hơi), NonMarking (Đặc trắng)
  rimType         String?       // Lip/Click (Mâm gài), Standard (Mâm thường)
  condition       String?       // NEW_100 (Mới), USED (Lướt)
  
  importPrice     Float
  sellingPrice    Float?        // Giá bán lẻ mặc định
  minStock        Int           @default(5)  // Định mức tồn tối thiểu để cảnh báo
  maxStock        Int           @default(100) // Định mức tồn tối đa
  imageUrl        String?
  description     String?
  slug            String?       @unique
  shortDescription String?
  highlights      Json?
  specifications  Json?
  applications    Json?
  seo             Json?
  tags             String[]      @default([])
  status           ContentStatus @default(PUBLISHED)
  createdAt       DateTime      @default(now())
  
  // Quan hệ
  stocks          StockLocation[]
  priceMatrix     PriceMatrix[]
  txDetails       TransactionDetail[]
  assemblyLogs    AssemblyLog[]
  orderItems      OrderItem[]
  productComments ProductComment[]
  favouriteProducts FavouriteProduct[]
}

model WheelRim {
  id               String        @id @default(uuid())
  sku              String        @unique // Mã QR mâm
  size             String        // Kích thước mâm tương ứng lốp
  boltHoles        Int           // Số lỗ bu-lông: 4, 5, 6, 8 lỗ
  compatibleModels String?       // Tương thích dòng xe nâng (Toyota, Komatsu...)
  brand            String?
  importPrice      Float
  sellingPrice     Float?
  createdAt        DateTime      @default(now())
  
  stocks           StockLocation[]
  txDetails        TransactionDetail[]
  assemblyLogs     AssemblyLog[]
  orderItems       OrderItem[]
}

model Warehouse {
  id        String     @id @default(uuid())
  code      String     @unique
  name      String
  address   String?
  locations Location[]
}

model Location {
  id           String          @id @default(uuid())
  warehouseId  String
  warehouse    Warehouse       @relation(fields: [warehouseId], references: [id])
  zone         String          // Dãy/Khu vực: A, B, C
  rack         String          // Kệ/Hàng: 01, 02
  slot         String          // Cột/Ô trống: 01, 02
  locationCode String          @unique // Mã QR vị trí: K1-ZA-R01-S02
  capacity     Int             @default(50) // Sức chứa tối đa (chiều cao lốp)
  createdAt    DateTime        @default(now())
  
  stocks       StockLocation[]
  stockRecords Stock[]
  txDetails    TransactionDetail[]
  orderItems   OrderItem[]
}

// Bảng trung gian quản lý tồn kho thực tế tại từng vị trí cột/kệ cụ thể
model StockLocation {
  id         String    @id @default(uuid())
  locationId String
  location   Location  @relation(fields: [locationId], references: [id])
  productId  String?
  product    Product?  @relation(fields: [productId], references: [id])
  wheelRimId String?
  wheelRim   WheelRim? @relation(fields: [wheelRimId], references: [id])
  quantity   Int       @default(0) // Số lượng thực tế tại vị trí này

  @@unique([locationId, productId, wheelRimId])
}

// Ma trận giá linh hoạt dành cho các tầng đại lý B2B
model PriceMatrix {
  id           String   @id @default(uuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  customerType String   // RETAIL, B2B_TIER1, B2B_TIER2
  price        Float
  
  @@unique([productId, customerType])
}

model Order {
  id              String              @id @default(uuid())
  code            String              @unique @default(uuid())
  clientId        String
  client          Client              @relation(fields: [clientId], references: [id])
  totalAmount     Float
  status          OrderStatus         @default(PENDING)
  stripeSessionId String?             @unique
  createdAt       DateTime            @default(now())
  items           OrderItem[]
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])
  productId  String?
  product    Product? @relation(fields: [productId], references: [id])
  wheelRimId String?
  wheelRim   WheelRim? @relation(fields: [wheelRimId], references: [id])
  locationId String
  location   Location @relation(fields: [locationId], references: [id])
  quantity   Int
  price      Float
}

// Nhật ký chi tiết phiếu nhập/xuất kho gắn liền với vị trí
model InventoryTransaction {
  id           String              @id @default(uuid())
  code         String              @unique // Số phiếu nhập/xuất tự sinh
  type         TransactionType
  partnerName  String?             // Tên nhà cung cấp hoặc khách mua lẻ
  userId       String              // Người thực hiện giao dịch (Storekeeper/Admin)
  createdAt    DateTime            @default(now())
  details      TransactionDetail[]
}

model Stock {
  id         String    @id @default(uuid())
  categoryId String
  category   Category  @relation(fields: [categoryId], references: [id])
  locationId String
  location   Location  @relation(fields: [locationId], references: [id])
  quantity   Int       @default(0)
  createdAt  DateTime  @default(now())
}

model TransactionDetail {
  id            String               @id @default(uuid())
  txId          String
  transaction   InventoryTransaction @relation(fields: [txId], references: [id])
  productId     String?
  product       Product?             @relation(fields: [productId], references: [id])
  wheelRimId    String?
  wheelRim      WheelRim?            @relation(fields: [wheelRimId], references: [id])
  locationId    String
  location      Location             @relation(fields: [locationId], references: [id])
  quantity      Int
  price         Float                // Giá thực tế tại thời điểm nhập/xuất
}

// Nhật ký quy trình Ép Mâm (Gộp lốp và mâm thành một combo hoàn chỉnh)
model AssemblyLog {
  id          String    @id @default(uuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  wheelRimId  String
  wheelRim    WheelRim  @relation(fields: [wheelRimId], references: [id])
  quantity    Int       // Số lượng bộ lốp đã ép thành công
  pressingFee Float     @default(0) // Chi phí công ép mâm
  userId      String    // Storekeeper thực hiện ép
  createdAt   DateTime  @default(now())
}

model Post {
  id        String   @id @default(uuid())
  title     String
  content   String
  videoUrl  String?
  slug      String?       @unique
  excerpt   String?
  tableOfContents Json?
  seo       Json?
  tags      String[]      @default([])
  status    ContentStatus @default(PUBLISHED)
  createdAt DateTime @default(now())
  postComments PostComment[]
}

model AiGeneration {
  id          String             @id @default(cuid())
  type        AiGenerationType
  prompt      String
  input       Json
  output      Json?
  status      AiGenerationStatus @default(PENDING)
  provider    String?
  model       String?
  error       String?
  createdById String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

// User interactions
model ProductComment {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  content   String
  rating    Int?
  createdAt DateTime @default(now())
}

model FavouriteProduct {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([productId, userId])
}

model PostComment {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  content   String
  createdAt DateTime @default(now())
}
