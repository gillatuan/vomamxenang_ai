datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN_MANAGER
  STOREKEEPER
}

enum ProductType {
  TIRE
  RIM
  SERVICE
}

enum TireType {
  SOLID
  PNEUMATIC
  NON_MARKING
}

enum RimType {
  LIP
  CLICK
  STANDARD
}

enum TireCondition {
  NEW
  USED
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
}

enum QuoteLeadStatus {
  NEW
  CONTACTED
  QUOTED
  WON
  LOST
}

enum AiGenerationType {
  PRODUCT
  BLOG
  SEO
}

enum AiGenerationStatus {
  PENDING
  SUCCESS
  FAILED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum DailyContentRunStatus {
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
}

enum DailyContentPlanStatus {
  PLANNED
  GENERATING
  DRAFT
  PUBLISHED
  FAILED
}

enum SeoKeywordType {
  PRIMARY
  SECONDARY
  SUPPORTING
  BRANDED
  LOCAL
}

enum SeoKeywordIntent {
  INFORMATIONAL
  NAVIGATIONAL
  COMMERCIAL
  TRANSACTIONAL
}

enum SeoKeywordStatus {
  PLANNED
  ACTIVE
  PAUSED
  ARCHIVED
}

enum SeoAuditScope {
  SITE
  PRODUCT
  POST
}

enum SeoAuditStatus {
  PENDING
  COMPLETED
  FAILED
}

enum TransactionType {
  IMPORT // Nhập kho thông thường
  EXPORT // Xuất kho bán hàng
  ASSEMBLY_OUT // Xuất vỏ/mâm để mang đi ép thành bộ
  ASSEMBLY_IN // Nhập bộ vỏ mâm hoàn chỉnh sau khi ép (hoặc rã bánh)
}

model User {
  id                String             @id @default(uuid())
  email             String             @unique
  password          String
  role              Role               @default(STOREKEEPER)
  createdAt         DateTime           @default(now())
  productComments   ProductComment[]
  favouriteProducts FavouriteProduct[]
  postComments      PostComment[]
}

model Client {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  phone     String
  company   String?
  type      String   @default("RETAIL") // RETAIL (Khách lẻ), B2B_TIER1, B2B_TIER2
  notes     String?
  createdAt DateTime @default(now())
  orders    Order[]
}

model Supplier {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  phone     String?
  company   String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
}

model StoreInfo {
  id            String   @id @default(uuid())
  name          String
  address       String
  phone         String
  email         String?
  website       String?
  taxCode       String?
  logoUrl       String?
  facebookUrl   String?
  googleMapsUrl String?
  latitude      Float?
  longitude     Float?
  businessHours String?
  notes         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AboutPage {
  id          String   @id @default(uuid())
  title       String
  summary     String
  content     String
  imageUrl    String?
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Tracks immutable, versioned data releases independently for each database.
// A seed is recorded only after its transaction has completed successfully.
model SeedHistory {
  id         String   @id @default(cuid())
  key        String   @unique
  name       String
  executedAt DateTime @default(now())
}

model Category {
  id             String        @id @default(uuid())
  name           String
  tireSize       String
  brand          String
  tireType       TireType
  rimType        RimType
  origin         String
  condition      TireCondition
  specifications String?
  createdAt      DateTime      @default(now())
  stocks         Stock[]
  products       Product[]
}

model Product {
  id   String      @id @default(uuid())
  sku  String      @unique // Mã QR tổng sản phẩm
  type ProductType @default(TIRE)
  name String // Tên mô tả (Ví dụ: Vỏ đặc Casumina 6.00-9)
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // Thuộc tính đặc thù lốp xe nâng
  size      String? // Thông số kích thước: 6.00-9, 7.00-12
  brand     String? // Bridgestone, Casumina, Michelin...
  tireType  String? // Solid (Đặc), Pneumatic (Hơi), NonMarking (Đặc trắng)
  rimType   String? // Lip/Click (Mâm gài), Standard (Mâm thường)
  condition String? // NEW_100 (Mới), USED (Lướt)

  importPrice      Float
  sellingPrice     Float? // Giá bán lẻ mặc định
  minStock         Int           @default(5) // Định mức tồn tối thiểu để cảnh báo
  maxStock         Int           @default(100) // Định mức tồn tối đa
  imageUrl         String?
  description      String?
  slug             String?       @unique
  aliases          String[]      @default([])
  shortDescription String?
  highlights       Json?
  specifications   Json?
  applications     Json?
  seo              Json?
  tags             String[]      @default([])
  status           ContentStatus @default(PUBLISHED)
  createdAt        DateTime      @default(now())

  // Quan hệ
  stocks            StockLocation[]
  priceMatrix       PriceMatrix[]
  txDetails         TransactionDetail[]
  assemblyLogs      AssemblyLog[]
  orderItems        OrderItem[]
  productComments   ProductComment[]
  favouriteProducts FavouriteProduct[]
  seoKeywords       SeoKeyword[]
  seoAudits         SeoAudit[]          @relation("ProductSeoAudits")
  dailyContentPlans DailyContentPlan[]
  quoteLeads        QuoteLead[]

  @@index([categoryId])
}

model WheelRim {
  id               String   @id @default(uuid())
  sku              String   @unique // Mã QR mâm
  size             String // Kích thước mâm tương ứng lốp
  boltHoles        Int // Số lỗ bu-lông: 4, 5, 6, 8 lỗ
  compatibleModels String? // Tương thích dòng xe nâng (Toyota, Komatsu...)
  brand            String?
  importPrice      Float
  sellingPrice     Float?
  createdAt        DateTime @default(now())

  stocks       StockLocation[]
  txDetails    TransactionDetail[]
  assemblyLogs AssemblyLog[]
  orderItems   OrderItem[]
}

model Warehouse {
  id        String     @id @default(uuid())
  code      String     @unique
  name      String
  address   String?
  locations Location[]
}

model Location {
  id           String    @id @default(uuid())
  warehouseId  String
  warehouse    Warehouse @relation(fields: [warehouseId], references: [id])
  zone         String // Dãy/Khu vực: A, B, C
  rack         String // Kệ/Hàng: 01, 02
  slot         String // Cột/Ô trống: 01, 02
  locationCode String    @unique // Mã QR vị trí: K1-ZA-R01-S02
  capacity     Int       @default(50) // Sức chứa tối đa (chiều cao lốp)
  createdAt    DateTime  @default(now())

  stocks       StockLocation[]
  stockRecords Stock[]
  txDetails    TransactionDetail[]
  orderItems   OrderItem[]
}

// Bảng trung gian quản lý tồn kho thực tế tại từng vị trí cột/kệ cụ thể
model StockLocation {
  id         String    @id @default(uuid())
  locationId String
  location   Location  @relation(fields: [locationId], references: [id])
  productId  String?
  product    Product?  @relation(fields: [productId], references: [id])
  wheelRimId String?
  wheelRim   WheelRim? @relation(fields: [wheelRimId], references: [id])
  quantity   Int       @default(0) // Số lượng thực tế tại vị trí này

  @@unique([locationId, productId, wheelRimId])
}

// Ma trận giá linh hoạt dành cho các tầng đại lý B2B
model PriceMatrix {
  id           String  @id @default(uuid())
  productId    String
  product      Product @relation(fields: [productId], references: [id])
  customerType String // RETAIL, B2B_TIER1, B2B_TIER2
  price        Float

  @@unique([productId, customerType])
}

model QuoteLead {
  id            String          @id @default(cuid())
  name          String
  phone         String
  zalo          String?
  company       String?
  quantity      Int?
  forkliftModel String?
  location      String?
  note          String?
  imageUrl      String?
  source        String          @default("WEBSITE")
  landingPage   String?
  productId     String?
  product       Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  status        QuoteLeadStatus @default(NEW)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([status, createdAt])
  @@index([productId])
}

model Order {
  id              String      @id @default(uuid())
  code            String      @unique @default(uuid())
  clientId        String
  client          Client      @relation(fields: [clientId], references: [id])
  totalAmount     Float
  status          OrderStatus @default(PENDING)
  stripeSessionId String?     @unique
  createdAt       DateTime    @default(now())
  items           OrderItem[]
}

model OrderItem {
  id         String    @id @default(uuid())
  orderId    String
  order      Order     @relation(fields: [orderId], references: [id])
  productId  String?
  product    Product?  @relation(fields: [productId], references: [id])
  wheelRimId String?
  wheelRim   WheelRim? @relation(fields: [wheelRimId], references: [id])
  locationId String
  location   Location  @relation(fields: [locationId], references: [id])
  quantity   Int
  price      Float
}

// Nhật ký chi tiết phiếu nhập/xuất kho gắn liền với vị trí
model InventoryTransaction {
  id          String              @id @default(uuid())
  code        String              @unique // Số phiếu nhập/xuất tự sinh
  type        TransactionType
  partnerName String? // Tên nhà cung cấp hoặc khách mua lẻ
  userId      String // Người thực hiện giao dịch (Storekeeper/Admin)
  createdAt   DateTime            @default(now())
  details     TransactionDetail[]
}

model Stock {
  id         String   @id @default(uuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  locationId String
  location   Location @relation(fields: [locationId], references: [id])
  quantity   Int      @default(0)
  createdAt  DateTime @default(now())
}

model TransactionDetail {
  id          String               @id @default(uuid())
  txId        String
  transaction InventoryTransaction @relation(fields: [txId], references: [id])
  productId   String?
  product     Product?             @relation(fields: [productId], references: [id])
  wheelRimId  String?
  wheelRim    WheelRim?            @relation(fields: [wheelRimId], references: [id])
  locationId  String
  location    Location             @relation(fields: [locationId], references: [id])
  quantity    Int
  price       Float // Giá thực tế tại thời điểm nhập/xuất
}

// Nhật ký quy trình Ép Mâm (Gộp lốp và mâm thành một combo hoàn chỉnh)
model AssemblyLog {
  id          String   @id @default(uuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  wheelRimId  String
  wheelRim    WheelRim @relation(fields: [wheelRimId], references: [id])
  quantity    Int // Số lượng bộ lốp đã ép thành công
  pressingFee Float    @default(0) // Chi phí công ép mâm
  userId      String // Storekeeper thực hiện ép
  createdAt   DateTime @default(now())
}

model Post {
  id              String         @id @default(uuid())
  title           String
  content         String
  videoUrl        String?
  slug            String?        @unique
  aliases         String[]       @default([])
  excerpt         String?
  tableOfContents Json?
  seo             Json?
  tags            String[]       @default([])
  status          ContentStatus  @default(PUBLISHED)
  createdAt       DateTime       @default(now())
  postComments    PostComment[]
  seoKeywords     SeoKeyword[]
  seoAudits       SeoAudit[]     @relation("PostSeoAudits")
  campaignPosts   CampaignPost[]
  dailyContentPlans DailyContentPlan[]
}

// A date-keyed, reviewable automation log. `runDate` is always an
// Asia/Ho_Chi_Minh calendar date (YYYY-MM-DD), not a server timestamp.
model DailyContentRun {
  id        String                @id @default(cuid())
  runDate   String                @unique
  status    DailyContentRunStatus @default(RUNNING)
  startedAt DateTime              @default(now())
  finishedAt DateTime?
  error     String?
  summary   Json?
  plans     DailyContentPlan[]
}

model DailyContentPlan {
  id                String                 @id @default(cuid())
  runId             String
  run               DailyContentRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  slot              Int
  title             String
  slug              String                 @unique
  topic             String
  primaryKeyword    String
  secondaryKeywords String[]               @default([])
  searchIntent      String
  cluster           String
  targetProductId   String?
  targetProduct     Product?               @relation(fields: [targetProductId], references: [id], onDelete: SetNull)
  postId            String?                @unique
  post              Post?                  @relation(fields: [postId], references: [id], onDelete: SetNull)
  status            DailyContentPlanStatus @default(PLANNED)
  attempts          Int                    @default(0)
  internalLinks     Json?
  quality           Json?
  failureReason     String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@unique([runId, slot])
  @@index([status, createdAt])
  @@index([cluster, createdAt])
}

model AiGeneration {
  id          String             @id @default(cuid())
  type        AiGenerationType
  prompt      String
  input       Json
  output      Json?
  status      AiGenerationStatus @default(PENDING)
  provider    String?
  model       String?
  error       String?
  createdById String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

// User interactions
model ProductComment {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  content   String
  rating    Int?
  createdAt DateTime @default(now())
}

model FavouriteProduct {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([productId, userId])
}

model PostComment {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  content   String
  createdAt DateTime @default(now())
}

// V3 stores reviewable recommendations independently of published content.
enum BacklinkOpportunityType {
  FORUM
  BUSINESS_DIRECTORY
  INDUSTRY_DIRECTORY
  B2B_MARKETPLACE
  BLOG
  NEWS
  GUEST_POST
  SUPPLIER
  PARTNER
  ASSOCIATION
  COMMUNITY
  SOCIAL_PROFILE
  LOCAL_CITATION
  RESOURCE_PAGE
}

enum BacklinkStatus {
  DISCOVERED
  REVIEWING
  APPROVED
  CONTACTED
  SUBMITTED
  LIVE
  REJECTED
  REMOVED
}

model SeoAudit {
  id               String         @id @default(cuid())
  scope            SeoAuditScope  @default(SITE)
  status           SeoAuditStatus @default(COMPLETED)
  productId        String?
  product          Product?       @relation("ProductSeoAudits", fields: [productId], references: [id], onDelete: SetNull)
  postId           String?
  post             Post?          @relation("PostSeoAudits", fields: [postId], references: [id], onDelete: SetNull)
  subjectUrl       String?
  primaryKeyword   String?
  metaTitle        String?
  metaDescription  String?
  canonical        String?
  imageAlt         String?
  headingStructure Json?
  internalLinks    Json?
  issues           Json?
  score            Int?
  report           Json
  createdAt        DateTime       @default(now())

  @@index([scope, createdAt])
  @@index([productId, createdAt])
  @@index([postId, createdAt])
}

model SeoKeyword {
  id        String           @id @default(cuid())
  keyword   String           @unique
  type      SeoKeywordType   @default(PRIMARY)
  intent    SeoKeywordIntent @default(INFORMATIONAL)
  priority  Int              @default(3)
  cluster   String?
  targetUrl String
  productId String?
  product   Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  postId    String?
  post      Post?            @relation(fields: [postId], references: [id], onDelete: SetNull)
  status    SeoKeywordStatus @default(PLANNED)
  notes     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([cluster, status])
  @@index([productId])
  @@index([postId])
  @@index([status, priority])
}

model InternalLinkSuggestion {
  id         String   @id @default(cuid())
  sourceType String
  sourceId   String
  targetType String
  targetId   String
  sourceUrl  String
  targetUrl  String
  anchorText String
  reason     String
  score      Int
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([sourceType, sourceId, targetType, targetId])
}

model BacklinkOpportunity {
  id                   String                  @id @default(cuid())
  domain               String
  url                  String
  name                 String
  type                 BacklinkOpportunityType
  relevanceScore       Int?
  authorityScore       Int?
  spamRiskScore        Int?
  supportsRegistration Boolean?
  supportsPosting      Boolean?
  supportsProfileLink  Boolean?
  supportsGuestPost    Boolean?
  contactUrl           String?
  contactEmail         String?
  status               BacklinkStatus          @default(DISCOVERED)
  notes                String?
  evidence             String
  evidenceUrl          String
  details              Json
  suggestedTargetUrl   String
  suggestedAnchorTexts String[]
  suggestedApproach    String
  risk                 String                  @default("UNKNOWN")
  requiresManualReview Boolean                 @default(true)
  outreach             Json?
  discoveredAt         DateTime                @default(now())
  lastCheckedAt        DateTime?
  updatedAt            DateTime                @updatedAt
  backlinks            Backlink[]

  @@unique([domain, url])
  @@index([status, relevanceScore])
}

model Backlink {
  id               String              @id @default(cuid())
  opportunityId    String
  opportunity      BacklinkOpportunity @relation(fields: [opportunityId], references: [id])
  sourceUrl        String
  sourceDomain     String
  targetUrl        String
  anchorText       String?
  rel              String?
  firstSeenAt      DateTime?
  lastCheckedAt    DateTime?
  isLive           Boolean             @default(false)
  verificationNote String?

  @@unique([sourceUrl, targetUrl])
}

model ContentCampaign {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  description String?
  goal        String?
  status      ContentStatus  @default(DRAFT)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  posts       CampaignPost[]

  @@index([status, startsAt])
}

model CampaignPost {
  id         String          @id @default(cuid())
  campaignId String
  campaign   ContentCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  postId     String
  post       Post            @relation(fields: [postId], references: [id], onDelete: Restrict)
  sortOrder  Int             @default(0)
  plannedAt  DateTime?
  notes      String?
  createdAt  DateTime        @default(now())

  @@unique([campaignId, postId])
  @@index([campaignId, sortOrder])
  @@index([postId])
}


